# ---------------------------------------------------------------
# .env.example — copy this file to .env and fill in real values.
# This file is safe to commit. Never commit the real .env file.
# ---------------------------------------------------------------

# Django secret key.
# For local development a random key is generated automatically if this
# is not set, which is fine.
# In PRODUCTION this MUST be set to a long, fixed, random value.
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Set to False in production. True is the default when this is not set.
DEBUG=True

# Comma-separated list of allowed hostnames.
# Local default: 127.0.0.1,localhost
# Add your Render hostname in production, e.g.:
#   ALLOWED_HOSTS=your-app.onrender.com
ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated list of frontend origins allowed to make cross-origin requests.
# Only applied when DEBUG=False. Not required for local development.
# Example (production):
#   CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------
# Phase 2 — Database
# ---------------------------------------------------------------
# Not required for local development (SQLite is used automatically).
# Required in production (Render + Neon PostgreSQL).
#
# Copy the connection string from your Neon project dashboard.
# It will look like:
#   postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
#
# Never commit a real connection string to the repository.
DATABASE_URL=

# ---------------------------------------------------------------
# Phase 4 — Production Initialisation (initialize_production)
# ---------------------------------------------------------------
# Required in production so that the admin superuser can be created
# automatically during the Render build. Not needed for local development
# unless you want to test the management command locally.
#
# DJANGO_SUPERUSER_EMAIL     The email address for the Django admin account.
# DJANGO_SUPERUSER_PASSWORD  A strong password for the Django admin account.
#
# Set both in the Render dashboard Environment tab.
# Never commit real credentials here or anywhere in the repository.
# The build will fail clearly if either variable is missing.
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
